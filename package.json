{
  "name": "setup-google-api-linter",
  "version": "1.1.0",
  "description": "GitHub Action that installs and runs the Google AIP api-linter.",
  "author": "the-protobuf-project",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-protobuf-project/setup-google-api-linter.git"
  },
  "homepage": "https://github.com/the-protobuf-project/setup-google-api-linter#readme",
  "bugs": {
    "url": "https://github.com/the-protobuf-project/setup-google-api-linter/issues"
  },
  "keywords": [
    "github-action",
    "api-linter",
    "aip",
    "protobuf",
    "proto",
    "google",
    "linter"
  ],
  "scripts": {
    "build": "bun build src/main.ts --target=node --format=esm --outdir=dist --entry-naming=index.js && bun run scripts/postbuild.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check:metadata": "bun run scripts/check-action-metadata.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "all": "bun run lint && bun run typecheck && bun run check:metadata && bun run test && bun run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/glob": "^0.7.0",
    "@actions/http-client": "^4.0.1",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "latest",
    "typescript": "7.0.2"
  }
}
